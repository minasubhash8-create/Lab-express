<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0d9488" />
      <stop offset="50%" stop-color="#0891b2" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#14b8a6" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>
    <linearGradient id="glowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#e11d48" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#0f766e" flood-opacity="0.35" />
    </filter>
  </defs>

  <!-- Outer Rounded Badge Base -->
  <rect x="32" y="32" width="448" height="448" rx="112" fill="url(#primaryGrad)" filter="url(#shadow)" />
  
  <!-- Subtle Inner Ring -->
  <rect x="44" y="44" width="424" height="424" rx="100" fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="4" stroke-dasharray="16 8" />

  <!-- Medical Cross Geometry with Smooth Modern Curves -->
  <g fill="#ffffff" transform="translate(256, 256)">
    <!-- Vertical Cross Arm -->
    <rect x="-42" y="-140" width="84" height="280" rx="42" />
    <!-- Horizontal Cross Arm -->
    <rect x="-140" y="-42" width="280" height="84" rx="42" />
    
    <!-- Central Diagnostic Pulse / ECG Heartbeat Line in Vibrant Cyan -->
    <path d="M -130,0 L -70,0 L -40,-65 L -10,80 L 25,-75 L 55,35 L 75,0 L 130,0" 
          fill="none" 
          stroke="url(#primaryGrad)" 
          stroke-width="16" 
          stroke-linecap="round" 
          stroke-linejoin="round" />

    <!-- Laboratory Flask & Droplet Accents -->
    <circle cx="0" cy="-60" r="14" fill="url(#glowGrad)" />
  </g>

  <!-- Corner Speed Spark / Lightning Accent -->
  <path d="M 370 70 L 350 120 L 385 120 L 340 190 L 352 135 L 325 135 Z" fill="#fbbf24" />
</svg>
